A = R(A_coeff)
B = R(B_coeff)
D4 = R(D4_coeff)
D5 = R(D5_coeff)
D7 = R(D7_coeff)
Q2 = u^2 - QQ(25)/13*u + QQ(25)/13
C = QQ(13)^13/(QQ(2)^4*QQ(3)^3*QQ(5)^18)
F = u*D4^4*D5^5*D7^7
assert Q2*A^3 - F/C == B^2

T.<t> = PolynomialRing(QQ)
N = 169*t^3 - 975*t + 625
H = 3*(13*t-20)*(13*t-5)
q = 13*t^2 - 25*t + 25

def homogenized_substitution(P, degree):
    return T(sum(P[i]*N^i*H^(degree-i) for i in range(degree+1)))

Ah = homogenized_substitution(A,36)
Bh = homogenized_substitution(B,55)
D4h = homogenized_substitution(D4,3)
D5h = homogenized_substitution(D5,7)
D7h = homogenized_substitution(D7,7)

c4 = 13*N^2*q*Ah
c6 = 13*N^3*Bh
Delta = (c4^3-c6^2)/1728
Delta_factored = QQ(5)^18/(4*QQ(13)^11)*N^7*H^13*D4h^4*D5h^5*D7h^7
assert Delta == Delta_factored

K = FractionField(T)
EK = EllipticCurve(K,[0,0,0,-K(c4)/48,-K(c6)/864])

def fiber(t0, constant_twist=1):
    t0=QQ(t0); d=QQ(constant_twist)
    if Delta(t0)==0:
        raise ValueError("singular fiber")
    return EllipticCurve(QQ,[0,0,0,-d^2*c4(t0)/48,-d^3*c6(t0)/864])

def u_map(t0):
    t0=QQ(t0)
    return N(t0)/H(t0)
